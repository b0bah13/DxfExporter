<Window x:Class="DxfExporter.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DxfExporter"
        xmlns:chrome="http://schemas.microsoft.com/winfx/2006/xaml/presentation/shell"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        xmlns:Collections="clr-namespace:System.Collections;assembly=System.Runtime" 
        xmlns:System="clr-namespace:System;assembly=System.Runtime"
        xmlns:dxfExporter="clr-namespace:DxfExporter"
        mc:Ignorable="d"
        AllowsTransparency="False"
        Title="Информация об обновлении" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White"
        Height="350" Width="450" MinWidth="450" MinHeight="350" 
        FontSize="14" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для кнопок управления окном с анимацией -->
        <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border 
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2">
                            <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Ховер-эффект для обычных кнопок -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFDEDEDE"/>
                            </Trigger>

                            <!-- Эффект при нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCCCCCC"/>
                            </Trigger>

                            <!-- Дополнительные триггеры для кнопки закрытия -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="CloseButton"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#FFE81123"/>
                            </MultiTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="CloseButton"/>
                                    <Condition Property="IsMouseOver" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                            To="#FF444444"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                            To="White"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                                <Setter Property="Foreground" Value="#FF444444"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль плитки (Border) -->
        <Style x:Key="ToolTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D3D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Тень + изменение фона при наведении -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                    <Setter Property="BorderBrush" Value="#7A8CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль текста названия -->
        <Style x:Key="TileTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
        </Style>

        <!-- ======== Поля ввода / ComboBox стиль ======== -->
        <Style TargetType="{x:Type ComboBox}" x:Key="ComboBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="TextBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="SmallButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8CCDA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#ECEFF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DDE2EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <!-- Кастомная рамка окна -->
    <Border Grid.Row="0" 
                BorderBrush="#FFAAAAAA" 
                BorderThickness="1" 
                CornerRadius="2"
                Background="White">

        <Border.Effect>
            <DropShadowEffect 
                    Color="#40000000" 
                    BlurRadius="10" 
                    Direction="270" 
                    ShadowDepth="3"/>
        </Border.Effect>

        <Grid Background="White">
            <!-- Кастомный заголовок -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ваш заголовок с крупным шрифтом -->
            <Grid Grid.Row="0" Background="#FFEEEEEE" 
                  MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                               FontSize="16" 
                               Padding="10,5"
                               VerticalAlignment="Center"/>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" 
                            Click="CloseClick" 
                            Style="{StaticResource WindowControlButton}"
                            Tag="CloseButton"
                            ToolTip="Закрыть" IsTabStop="False"/>
                </StackPanel>
            </Grid>

            <!-- Основное содержимое окна -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="infoHeadText" TextWrapping="Wrap" Text="Что нового:" 
                           Margin="10,5,5,0" HorizontalAlignment="Left" 
                           />

                <TextBox x:Name="infoText" Margin="10,5,10,5" 
                           TextWrapping="Wrap" Text="Информация" 
                           Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" 
                           />

                <Button x:Name="okButton" Content="Ок" IsDefault="True" Grid.Row="2" 
                        Style="{StaticResource SmallButtonStyle}"
                        Click="okButton_Click"
                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Margin="0,5,0,10" Width="60" Height="25"/>
            </Grid>


        </Grid>
    </Border>
</Window>
