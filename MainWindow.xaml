<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DxfExporter.Scanning"
        xmlns:const="clr-namespace:DxfExporter.Constants"
        xmlns:chrome="http://schemas.microsoft.com/winfx/2006/xaml/presentation/shell"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        xmlns:Collections="clr-namespace:System.Collections;assembly=System.Runtime" 
        xmlns:System="clr-namespace:System;assembly=System.Runtime"
        xmlns:dxfExporter="clr-namespace:DxfExporter"
        xmlns:maskProcess="clr-namespace:DxfExporter.MaskProcess"
        x:Class="DxfExporter.MainWindow"
        mc:Ignorable="d"
        AllowsTransparency="False"
        Title="DXF Exporter"
        Width="980" Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White" 
        Icon="/dxf-file.ico" Cursor="" MinWidth="980" MinHeight="660">

    <Window.Resources>
        <!-- Серый цвет при IsUsed = true -->
        <maskProcess:BooleanToGrayConverter x:Key="BooleanToGrayConverter"/>

        <!-- Прозрачность 0.5 при использовании -->
        <maskProcess:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter"/>

        <!-- Инверсия bool для IsHitTestVisible (чтобы нельзя было кликнуть) -->
        <maskProcess:InvertBooleanConverter x:Key="InvertBooleanConverter"/>

        <Style x:Key="IntegerEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="dxfExporter:NumericTextBoxBehavior.InputMode" Value="Integer"/>
        </Style>

        <Style x:Key="DecimalEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="dxfExporter:NumericTextBoxBehavior.InputMode" Value="Decimal"/>
        </Style>

        <!-- Стиль для кнопок управления окном с анимацией -->
        <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border 
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2">
                            <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Ховер-эффект для обычных кнопок -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFDEDEDE"/>
                            </Trigger>

                            <!-- Эффект при нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCCCCCC"/>
                            </Trigger>

                            <!-- Дополнительные триггеры для кнопки закрытия -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="CloseButton"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#FFE81123"/>
                            </MultiTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="CloseButton"/>
                                    <Condition Property="IsMouseOver" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                            To="#FF444444"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                            To="White"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                                <Setter Property="Foreground" Value="#FF444444"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль плитки (Border) -->
        <Style x:Key="ToolTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D3D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Тень + изменение фона при наведении -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                    <Setter Property="BorderBrush" Value="#7A8CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль текста названия -->
        <Style x:Key="TileTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
        </Style>

        <!-- ======== Поля ввода / ComboBox стиль ======== -->
        <Style TargetType="{x:Type ComboBox}" x:Key="ComboBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="TextBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="SmallButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8CCDA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#ECEFF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DDE2EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <!-- Кастомная рамка окна -->
    <Border Grid.Row="0" 
                BorderBrush="#FFAAAAAA" 
                BorderThickness="1" 
                CornerRadius="2"
                Background="White">

        <Border.Effect>
            <DropShadowEffect 
                    Color="#40000000" 
                    BlurRadius="10" 
                    Direction="270" 
                    ShadowDepth="3"/>
        </Border.Effect>

        <Grid Background="White">
            <!-- Кастомный заголовок -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ваш заголовок с крупным шрифтом -->
            <Grid Grid.Row="0" Background="#FFEEEEEE" 
                  MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                               FontSize="16" 
                               Padding="10,5"
                               VerticalAlignment="Center"/>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="?" 
                            Click="InfoClick" 
                            Style="{StaticResource WindowControlButton}"
                            Tag="InfoButton"
                            ToolTip="Информация о программе" 
                            ToolTipService.InitialShowDelay="400"
                            IsTabStop="False"/>
                    <Button Content="—" 
                            Click="Minimize_Click" 
                            Style="{StaticResource WindowControlButton}"
                            Tag="MinimizeButton"
                            ToolTip="Свернуть"
                            ToolTipService.InitialShowDelay="400"
                            IsTabStop="False"/>

                    <Button x:Name="MaximizeButton" Content="⬜" 
                            Click="Maximize_Click"
                            Style="{StaticResource WindowControlButton}"
                            Tag="MaximizeButton"
                            ToolTip="Развернуть"
                            ToolTipService.InitialShowDelay="400"
                            IsTabStop="False"/>

                    <Button Content="✕" 
                            Click="CloseClick" 
                            Style="{StaticResource WindowControlButton}"
                            Tag="CloseButton"
                            ToolTip="Закрыть"
                            ToolTipService.InitialShowDelay="400"
                            IsTabStop="False"/>
                </StackPanel>
            </Grid>

            <!-- Основное содержимое окна -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0,1,0,0">
                <TabItem x:Name="HomeTab" Header="Главная">
                    <Grid Background="WhiteSmoke">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.ColumnSpan="3" Margin="5,5,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="scanButton" Width="80" Height="80" 
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTip="Сканировать сборку/деталь" 
                            ToolTipService.InitialShowDelay="400"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="scanButton_Click">
                                <StackPanel Height="75" Width="75">
                                    <Image Source="/binoculars.png" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock TextWrapping="Wrap" Text="Сканировать" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                                </StackPanel>

                            </Button>
                            <Rectangle Grid.Column="1"
                                       Width="1"
                                       Fill="#FFADADAD"
                                       StrokeThickness="0" Margin="5,2,5,2" />
                            <StackPanel Grid.Column="2">
                                <Button x:Name="addOpenFilesButton" Width="95" Height="37.5" 
                                    Style="{StaticResource SmallButtonStyle}"
                                    ToolTip="Добавить открытые файлы" 
                                    ToolTipService.InitialShowDelay="400" Click="addOpenFilesButton_Click">
                                    <Grid Width="85">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/add-file.png" Width="25" HorizontalAlignment="Center"/>
                                        <TextBlock TextWrapping="Wrap" Text="Добавить" TextAlignment="Center" Margin="5,0,0,0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    </Grid>

                                </Button>
                                <Button x:Name="choiceFilesButton" Width="95" Height="37.5" 
                                    Style="{StaticResource SmallButtonStyle}"
                                    ToolTip="Выбрать файлы из папки" 
                                    ToolTipService.InitialShowDelay="400" Click="choiceFilesButton_Click" Margin="0,5,0,0" HorizontalContentAlignment="Center">
                                    <Grid Width="85">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Open-folder-add.png" Width="25" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock TextWrapping="Wrap" Text="Выбрать" 
                                                   TextAlignment="Center" VerticalAlignment="Center" 
                                                   Margin="5,0,0,0" Grid.Column="1" 
                                                   HorizontalAlignment="Left"/>

                                    </Grid>

                                </Button>
                            </StackPanel>
                            <Rectangle Grid.Column="3"
                                Width="1"
                                Fill="#FFADADAD"
                                StrokeThickness="0" Margin="5,2,5,2" />
                            <Button x:Name="clearListButton" Width="80" Height="80" 
                                Style="{StaticResource SmallButtonStyle}"
                                ToolTip="Очистить список"
                                ToolTipService.InitialShowDelay="400"
                                HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Click="clearListButton_Click" Grid.Column="4">
                                <StackPanel Height="75" Width="75">
                                    <Image Source="/refresh.png" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock TextWrapping="Wrap" Text="Очистить" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                                </StackPanel>

                            </Button>
                            <Button x:Name="startButton" Width="80" Height="80" 
                            Style="{StaticResource SmallButtonStyle}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="6" 
                            ToolTip="Выгрузить dxf выбранных файлов" 
                            ToolTipService.InitialShowDelay="400" Click="startButton_Click">
                                <StackPanel Height="75" Width="75">
                                    <Image Source="/dxf.png" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock TextWrapping="Wrap" Text="Создать DXF" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                                </StackPanel>

                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,5" Grid.ColumnSpan="2">
                            <TextBox x:Name="searchBox" TextWrapping="Wrap" Width="300" 
                                     Style="{StaticResource TextBoxStyle}"
                                     TextChanged="SearchBox_TextChanged" 
                                     ToolTip="Поиск по выбранному столбцу"
                                     ToolTipService.InitialShowDelay="400"
                                     VerticalContentAlignment="Center"
                                     />
                            <ComboBox x:Name="searchComboBox" Width="120" Margin="5,0,0,0" 
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemsSource="{x:Static const:HeaderConst.AllFields}"
                                      ToolTip="Выбор столбца для поиска" 
                                      ToolTipService.InitialShowDelay="400"
                                      SelectedIndex="0" SelectionChanged="searchComboBox_SelectionChanged"/>
                            <Button x:Name="clearButton" Content="Сбросить"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Click="clearButton_Click"
                                    HorizontalAlignment="Center" 
                                    ToolTip="Сбросить строку поиска"
                                    ToolTipService.InitialShowDelay="400"
                                    Margin="5,0,0,0" Width="70"/>
                        </StackPanel>
                        <Button x:Name="openButton" Content="Открыть"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="openButton_Click" 
                            ToolTip="Открыть папку с выгруженными развёртками"
                            ToolTipService.InitialShowDelay="400"
                            Width="80" Grid.Row="1" Grid.Column="2" Margin="5,0,5,5"/>

                        <DataGrid x:Name="scanData" 
                                  d:ItemsSource="{d:SampleData ItemCount=5}" 
                                  Grid.Row="2" Margin="5,0,5,0" 
                                  CanUserAddRows="False" 
                                  AutoGenerateColumns="False" 
                                  Grid.ColumnSpan="3" CanUserDeleteRows="False"
                                  ContextMenuOpening="scanData_ContextMenuOpening" BorderBrush="#FF688CAF"
                                  >

                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" 
                                            Value="{Binding RowColor}" />
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Выгрузить" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding NeedUnload, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanderGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <Expander Header="{Binding DisplayName}"
                                                          FontWeight="SemiBold"
                                                          >
                                                    <Expander.Style>
                                                        <Style TargetType="Expander">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanderGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Expander.Style>
                                                    <DataGrid ItemsSource="{Binding GroupMembers}"
                                                              AutoGenerateColumns="False"
                                                              CanUserAddRows="False"
                                                              CanUserDeleteRows="False"
                                                              Margin="0,6,0,6"
                                                              HeadersVisibility="Column"
                                                              BorderBrush="#FFD0D8EE"
                                                              BorderThickness="1">
                                                        <DataGrid.Columns>
                                                            <DataGridCheckBoxColumn Header="Выгрузить" Binding="{Binding NeedUnload, UpdateSourceTrigger=PropertyChanged}" Width="0.7*"/>
                                                            <DataGridTextColumn Header="{x:Static const:HeaderConst.Обозначение}" Binding="{Binding PartNumber}" Width="2.2*" IsReadOnly="True"/>
                                                            <DataGridTextColumn Header="{x:Static const:HeaderConst.Наименование}" Binding="{Binding Description}" Width="1.5*" IsReadOnly="True"/>
                                                            <DataGridTextColumn Header="{x:Static const:HeaderConst.Материал}" Binding="{Binding Material}" Width="0.8*" IsReadOnly="True"/>
                                                            <DataGridTextColumn Header="{x:Static const:HeaderConst.Толщина}" Binding="{Binding Thickness}" Width="0.6*"/>
                                                            <DataGridTextColumn Header="{x:Static const:HeaderConst.Количество}" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="0.6*"/>
                                                            <DataGridTextColumn Header="Свойства выгрузки" Binding="{Binding UnloadProp}" Width="1.1*" IsReadOnly="True"/>
                                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Expander>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{x:Static const:HeaderConst.Обозначение}" Binding="{Binding PartNumber}" Width="2.8*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{x:Static const:HeaderConst.Наименование}" Binding="{Binding Description}" Width="1.8*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{x:Static const:HeaderConst.Материал}" Binding="{Binding Material}" Width="0.8*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{x:Static const:HeaderConst.Толщина}" Binding="{Binding Thickness}" EditingElementStyle="{StaticResource DecimalEditingTextBoxStyle}" Width="0.58*"/>
                                <DataGridTextColumn Header="{x:Static const:HeaderConst.Количество}" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource IntegerEditingTextBoxStyle}" Width="0.5*"/>
                                <DataGridTextColumn Header="Свойства выгрузки" Binding="{Binding UnloadProp}" Width="1.15*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>

                            <!-- Контекстное меню -->
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="ContextMenu_Opened">
                                    <!-- Обычный пункт меню -->
                                    <MenuItem Header="Изменить материал"
                                              Click="MenuItem_ChangeMaterial_Click"/>
                                    <MenuItem Header="Добавить материал"
                                              Click="MenuItem_AddMaterial_Click"/>
                                    <Separator/>

                                    <!-- Чекбоксы – управляют выбранными строками -->
                                    <MenuItem Header="Выгрузить"
                                              IsCheckable="True"
                                              Checked="Menu_Checked_General"
                                              Unchecked="Menu_Unchecked_General"
                                              ToolTip="Свойство указывающее будет ли выгружен DXF"
                                              ToolTipService.InitialShowDelay="400"
                                              Tag="NeedUnload"/>

                                    <MenuItem Header="Гравировка"
                                              IsCheckable="True"
                                              Checked="Menu_Checked_General"
                                              Unchecked="Menu_Unchecked_General"
                                              ToolTip="Свойство указывающее будет ли выгружена гравировка"
                                              ToolTipService.InitialShowDelay="400"
                                              Tag="NeedGrav"/>

                                    <MenuItem Header="Линии гиба"
                                              Tag="NeedBendLine"
                                              IsCheckable="True"
                                              Checked="Menu_Checked_General"
                                              Unchecked="Menu_Unchecked_General"
                                              ToolTip="Свойство указывающее будут ли выгружены линии гиба"
                                              ToolTipService.InitialShowDelay="400"
                                              />

                                    <MenuItem Header="Выгрузить в шаблон"
                                              Tag="UnloadInTemplate"
                                              IsCheckable="True"
                                              Checked="Menu_Checked_General"
                                              Unchecked="Menu_Unchecked_General"
                                              ToolTip="Свойство указывающее будет ли выгружен DXF в папку 'Шаблоны'"
                                              ToolTipService.InitialShowDelay="400"/>
                                    <Separator/>
                                    <MenuItem Header="Оставить выбранные"
                                              Click="MenuItem_InvertCheck_Click"
                                              ToolTip="Оставляет свойство 'Выгрузить' только у выбранных строк"
                                              ToolTipService.InitialShowDelay="400"
                                              />

                                    <MenuItem Header="Открыть деталь"
                                              Click="MenuItem_OpenFile_Click"
                                    />

                                </ContextMenu>
                            </DataGrid.ContextMenu>

                        </DataGrid>

                        <StatusBar Grid.ColumnSpan="3"
                                   Grid.Row="3" 
                                   Margin="5,0,5,0" 
                                   DockPanel.Dock="Bottom"
                                   VerticalAlignment="Bottom" Background="{x:Null}"
                                   >
                            <!-- левая часть — основное сообщение -->
                            <StatusBarItem>
                                <TextBlock x:Name="txtStatus" 
                                           Text="Готов к сканированию" 
                                           MinWidth="200"/>
                            </StatusBarItem>

                            <!-- справа — версия -->
                            <StatusBarItem HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Версия:" Foreground="DimGray" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AppVersion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                               Foreground="DimGray" VerticalAlignment="Center" 
                                               Margin="3,0,3,0"/>
                                    <Button Content="i" 
                                            Click="VersInfoClick" 
                                            Style="{StaticResource SmallButtonStyle}"
                                            Tag="VersInfoButton"
                                            ToolTip="Информация об обновлениях" 
                                            ToolTipService.InitialShowDelay="400"
                                            IsTabStop="False" Width="18"/>
                                </StackPanel>
                            </StatusBarItem>

                            <!-- тонкая разделительная линия сверху -->

                        </StatusBar>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SettingsTab" Header="Настройки">
                    <Grid Margin="10,10,10,10" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Основная область (будет отключаться при Стандарт / Материал) -->
                        <GroupBox Header="Папки выгрузки" Width="600" HorizontalAlignment="Left">
                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="userDirect" Content="Пользовательское расположение папки DXF" 
                                    IsChecked="False" Margin="5,3,5,5" 
                                    ToolTipService.InitialShowDelay="400"
                                    Checked="categorizeFolder_Checked" Unchecked="categorizeFolder_Checked"/>
                                <CheckBox x:Name="categorizeMaterial" Content="Распределить по материалам" 
                                          IsChecked="True" Margin="5,0,5,5" 
                                          ToolTipService.InitialShowDelay="400"
                                          Checked="categorizeFolder_Checked" Unchecked="categorizeFolder_Checked" Grid.Row="1"/>
                                <CheckBox x:Name="categorizeThickness" Content="Распределить по толщинам" Grid.Row="2" 
                                          IsChecked="True" Margin="5,0,5,0" 
                                          ToolTipService.InitialShowDelay="400"
                                          Checked="categorizeFolder_Checked" Unchecked="categorizeFolder_Checked"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="gbCheckGab" Header="Проверка габаритов развёртки" Grid.Row="1" HorizontalAlignment="Left" Width="600">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <CheckBox
                                    Unchecked="checkGab_Checked" x:Name="checkGab" 
                                    Margin="5,3,5,5" IsChecked="True" 
                                    ToolTipService.InitialShowDelay="400"
                                    Content="Проверить габарит развёртки при выгрузке" 
                                    Checked="checkGab_Checked" HorizontalAlignment="Left"/>

                                <Expander Header="Ссылка на таблицу соответствия" Grid.Row="1" 
                                          Margin="5,0,5,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TablePath" TextWrapping="Wrap"
                                                 TextChanged="TablePath_TextChanged" VerticalContentAlignment="Center" 
                                                 ToolTipService.InitialShowDelay="400"
                                                 Margin="5,5,5,5" Height="20"/>
                                        <Button x:Name="browseButton" Content="Обзор" Width="60" 
                                                HorizontalAlignment="Left" Height="20" Click="browseButton_Click" 
                                                ToolTip="Выбор файла Excel"
                                                ToolTipService.InitialShowDelay="400"
                                                Grid.Row="1" Margin="5,0,0,0"/>
                                    </Grid>
                                </Expander>

                            </Grid>
                        </GroupBox>

                        <!-- Основная область (будет отключаться при Стандарт / Материал) -->
                        <GroupBox x:Name="gbMaskSettings"
                                  Grid.Row="2" Header="Шаблон имени файла" 
                                  Margin="0,5,0,0"
                                  
                                  Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">

                            <StackPanel>

                                <ComboBox x:Name="templateComboBox" 
                                  ItemsSource="{x:Static const:MaskConst.AllFields}"
                                  SelectedIndex="0" SelectionChanged="templateComboBox_SelectionChanged"
                                  ToolTip="Выбор шаблона"
                                  ToolTipService.InitialShowDelay="400"
                                  Width="150" Height="22" HorizontalAlignment="Left" Margin="3,3,0,5"/>

                                <Grid x:Name="gridSettings" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <ListBox x:Name="AvailableList"
                                             ItemsSource="{Binding AvailableHeaders}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="AvailableList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="AvailableList_PreviewMouseMove"
                                             Drop="AvailableList_Drop"
                                             SelectionMode="Single" 
                                             MouseDoubleClick="AvailableList_MouseDoubleClick" 
                                             Height="130" VerticalAlignment="Top">

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Key}"
                                                           Foreground="{Binding IsUsed, Converter={StaticResource BooleanToGrayConverter}}"
                                                           Opacity="{Binding IsUsed, Converter={StaticResource BooleanToOpacityConverter}}"
                                                           IsHitTestVisible="{Binding IsUsed, Converter={StaticResource InvertBooleanConverter}}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <DockPanel Margin="0,5,0,0" VerticalAlignment="Top">
                                            <TextBlock TextWrapping="Wrap" 
                                                       DockPanel.Dock="Top"
                                                       Text="Пользовательский текст:" HorizontalAlignment="Left" 
                                                       Margin="0,0,0,3" Visibility="Collapsed"/>
                                            <Button DockPanel.Dock="Right"
                                                Content="Добавить →" 
                                                Width="90"
                                                ToolTip="Добавить текст в правый список"
                                                ToolTipService.InitialShowDelay="400"
                                                Click="AddCustomText_Click"/>

                                            <TextBox x:Name="txtCustomText"
                                                 Text="{Binding CustomText}"
                                                 TextChanged="TxtCustomText_TextChanged"
                                                 ToolTip="Ввод пользовательского текста"
                                                 ToolTipService.InitialShowDelay="400"
                                                 Margin="0,0,5,0"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" 
                                            Margin="10,0,10,0" VerticalAlignment="Top">
                                        <Button Content="⯈" Click="AddFromLeft_Click" Margin="0,0,0,5" Width="20" Height="20"
                                            ToolTip="Добавить элемент"
                                            ToolTipService.InitialShowDelay="400"
                                            />
                                        <Button Content="⯇" Click="RemoveSelected_Click" Margin="0,0,0,5" Height="20"
                                            ToolTip="Удалить элемент"
                                            ToolTipService.InitialShowDelay="400"
                                            Width="20"/>
                                        <Separator/>
                                        <Button Content="⯅" Click="MoveUp_Click" Margin="0,5,0,5" Height="20"
                                            ToolTip="Переместить элемент вверх" 
                                            ToolTipService.InitialShowDelay="400"
                                            Width="20"/>
                                        <Button Content="⯆" Click="MoveDown_Click" Margin="0,0,0,5" Height="20"
                                            ToolTip="Переместить элемент вниз"
                                            ToolTipService.InitialShowDelay="400"
                                            Width="20"/>
                                        <Separator/>
                                        <Button Content="X" Click="ClearMaskParts_Click" Width="20" 
                                            Height="20" Margin="0,5,0,0"
                                            ToolTip="Очистить список"
                                            ToolTipService.InitialShowDelay="400"
                                            />
                                    </StackPanel>
                                    <ListBox x:Name="SelectedList"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="SelectedList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="SelectedList_PreviewMouseMove"
                                         Drop="SelectedList_Drop"
                                         SelectionMode="Single" 
                                         MouseDoubleClick="SelectedList_MouseDoubleClick" 
                                         Grid.Column="2"
                                         ItemsSource="{Binding MaskParts}" 
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                       Margin="6,3"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                            </StackPanel>

                        </GroupBox>
                        <Button x:Name="clearSettingsButton" Width="80" Height="80" 
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTip="Восстановить базовые настройки"
                            ToolTipService.InitialShowDelay="400"
                            HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Click="clearSettingsButton_Click">
                            <StackPanel Height="75" Width="75">
                                <Image Source="/refresh settings.png" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                <TextBlock TextWrapping="Wrap" Text="Сбросить" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                            </StackPanel>

                        </Button>
                    </Grid>

                </TabItem>

                <TabItem Header="Логи">
                    <Grid Background="WhiteSmoke">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Процесс выполнения:" VerticalAlignment="Top" Margin="10,5,0,0"/>
                        <TextBox x:Name="LogTextBox" TextWrapping="Wrap" 
                                 Grid.Row="1" Margin="10,5,10,10" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Анимированное окно ожидания -->
            <Grid x:Name="OverlayGrid" Background="#80000000" Grid.RowSpan="2" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#FFFFFF" CornerRadius="10" Padding="20" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="305" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Контейнер для логотипа + круглой маски -->
                            <Grid Width="100" Height="100" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                                <!-- Круглый маскирующий оверлей (тёмно-серый) -->
                                <!-- При 0% высота = 100 → полностью закрывает, при 100% = 0 → ничего не закрывает -->
                                <!-- Цветная картинка, которая вращается -->
                                <Image x:Name="Logo" 
                                   Height="100" Width="100"
                                   Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="/logo_ZV1.png">
                                    <Image.RenderTransform>
                                        <RotateTransform x:Name="rotation" Angle="0"/>
                                    </Image.RenderTransform>
                                    <Image.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                    Storyboard.TargetName="rotation"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360" Duration="0:0:2"
                                                    RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Image.Triggers>
                                </Image>

                                <!-- подбери 0.6–0.9 под свою картинку -->
                                <Ellipse x:Name="DesaturateOverlay"
                                     Fill="#808080"          
                                     Opacity="0.9"
                                     VerticalAlignment="Top"
                                     Height="100"
                                     Width="100">
                                    <!-- Чтобы круг не обрезался по краям контейнера -->
                                    <Ellipse.Clip>
                                        <EllipseGeometry Center="50,50" RadiusX="41" RadiusY="41"/>
                                    </Ellipse.Clip>
                                </Ellipse>
                            </Grid>

                            <StackPanel VerticalAlignment="Top" Width="205" Margin="0,20,0,0">
                                <!-- Анимированное изображение -->
                                <TextBlock x:Name="OverlayText" 
                                FontSize="16"
                                Margin="10,0,5,0" FontStyle="Italic" VerticalAlignment="Top" ><Run Text="Пожалуйста, подождите"/><LineBreak /><Run Text="Сборка сканируется"/></TextBlock>
                                <TextBlock x:Name="OverlayProcessText" 
                                FontSize="16"
                                FontStyle="Italic" Margin="10,0,5,0" TextWrapping="Wrap" Visibility="Collapsed" ><Run Text="деталь..."/></TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="tb_quote" Grid.Row="1" 
                                   TextWrapping ="Wrap"
                                   Text="Это вам не это " 
                                   FontSize="16" Visibility="Collapsed" FontStyle="Italic" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Ознакомительный режим -->
            <Grid x:Name="TourOverlay"
                  Grid.RowSpan="2"
                  Grid.Row="1"
                  Panel.ZIndex="100"
                  Visibility="Collapsed"
                  Background="#01FFFFFF"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Canvas>
                    <Path x:Name="TourDimPath"
                          Fill="#B0000000"
                          Canvas.Left="0"
                          Canvas.Top="0"/>
                    <Border x:Name="TourHighlightBorder"
                            BorderBrush="#FFFFD34D"
                            BorderThickness="2"
                            CornerRadius="6"
                            Background="Transparent"
                            Canvas.Left="0"
                            Canvas.Top="0"/>
                    <Border x:Name="TourTooltipBorder"
                            Background="White"
                            CornerRadius="8"
                            Padding="12"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TourTitleText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TourDescriptionText"
                                       TextWrapping="Wrap"
                                       Width="260"
                                       />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="TourPrevButton"
                                        Content="Назад"
                                        Click="TourPrev_Click"
                                        Margin="0,0,6,0"
                                        MinWidth="70"/>
                                <Button x:Name="TourNextButton"
                                        Content="Вперёд"
                                        Click="TourNext_Click"
                                        Margin="0,0,6,0"
                                        MinWidth="70"/>
                                <Button x:Name="TourCloseButton"
                                        Content="Закрыть"
                                        Click="TourClose_Click"
                                        MinWidth="70"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>



        </Grid>
    </Border>


</Window>
