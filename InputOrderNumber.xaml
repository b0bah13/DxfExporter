<Window x:Class="DxfExporter.InputOrderNumber"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DxfExporter"
        mc:Ignorable="d"
        AllowsTransparency="False"
        Title="Гравировка" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White"
        Height="150" Width="300" FontSize="14">


    <Window.Resources>
        <!-- Стиль для кнопок управления окном с анимацией -->
        <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border 
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2">
                            <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Ховер-эффект для обычных кнопок -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFDEDEDE"/>
                            </Trigger>

                            <!-- Эффект при нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCCCCCC"/>
                            </Trigger>

                            <!-- Дополнительные триггеры для кнопки закрытия -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="CloseButton"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#FFE81123"/>
                            </MultiTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="CloseButton"/>
                                    <Condition Property="IsMouseOver" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                            To="#FF444444"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                            To="White"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                                <Setter Property="Foreground" Value="#FF444444"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль плитки (Border) -->
        <Style x:Key="ToolTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D3D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Тень + изменение фона при наведении -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                    <Setter Property="BorderBrush" Value="#7A8CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль текста названия -->
        <Style x:Key="TileTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
        </Style>

        <!-- ======== Поля ввода / ComboBox стиль ======== -->
        <Style TargetType="{x:Type ComboBox}" x:Key="ComboBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="5,2,5,2"/>
            <!-- больше справа, чтобы не налезало на стрелку -->
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <!-- Основная рамка -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <!-- Содержимое + кнопка стрелки -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Невидимая область клика -->
                                <ToggleButton
                                    Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    OverridesDefaultStyle="True"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>

                                </ToggleButton>


                                <!-- Выбранное значение / редактируемый текст -->
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                <!-- Кнопка со стрелкой (ToggleButton) -->
                                <ToggleButton x:Name="ToggleButton"
                                  Grid.Column="1"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False"
                                  ClickMode="Press"
                                  Padding="5,0"
                                  Background="Transparent"
                                  BorderBrush="Transparent">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" 
                                        Width="20" 
                                        HorizontalAlignment="Right">
                                                <Path x:Name="Arrow"
                                          Margin="0,1,0,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#666666"
                                          Width="8"
                                          Height="5"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <!-- Выпадающий список -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Margin="1,1,1,1">
                                <Border x:Name="DropDownBorder"
                                                Background="White"
                                                BorderBrush="#C5CAD5"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Неактивный -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.56"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>

                            <!-- Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7EB4EA"/>
                            </Trigger>

                            <!-- Фокус -->
                            <Trigger Property="IsFocused" Value="True" SourceName="Bd">
                                <!-- или просто IsKeyboardFocusWithin -->
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#569DE5"/>
                            </Trigger>

                            <!-- Открытый дропдаун (можно усилить цвет) -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#569DE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>


        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="TextBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="2,2,2,2"/>
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Top"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.56" TargetName="Bd"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7EB4EA" TargetName="Bd"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#569DE5" TargetName="Bd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="{x:Type Button}" x:Key="SmallButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8CCDA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#ECEFF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DDE2EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== TAB CONTROL ====================== -->
        <Style TargetType="{x:Type TabControl}" x:Key="TabControlStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Заголовки вкладок -->
                            <TabPanel x:Name="HeaderPanel"
                              Background="Transparent"
                              IsItemsHost="True"
                              Panel.ZIndex="1"
                              Margin="5,0,5,0"
                              HorizontalAlignment="Stretch"/>

                            <!-- Содержимое -->
                            <Border x:Name="ContentBorder"
                            Background="White"
                            BorderBrush="#C5CAD5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="2,-1,2,0" VerticalAlignment="Stretch" Grid.Row="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== TAB ITEM ====================== -->
        <Style TargetType="{x:Type TabItem}" x:Key="TabItemStyle">
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Padding" Value="10,10,10,10"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0"
                        MinHeight="25" Margin="0,0,4,0" Padding="8,2,8,2"
                        >
                            <ContentPresenter x:Name="ContentSite"
                                      ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" Margin="0,0,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Активная вкладка -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#C5CAD5"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                                <Setter TargetName="Border" Property="Panel.ZIndex" Value="1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>

                            <!-- Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFF"/>
                            </Trigger>

                            <!-- Активная + Наведение -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </MultiTrigger>

                            <!-- Неактивное состояние -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>


                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>

                                <Setter Property="Cursor" Value="Hand"/>
                            </MultiTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== LISTBOX ====================== -->
        <Style TargetType="{x:Type ListBox}" x:Key="ListBoxStyle">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="3,3,3,3"/>
            <Setter Property="BorderBrush" Value="#C5CAD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">

                            <ScrollViewer 
                                Focusable="False"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter 
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    SnapsToDevicePixels="True"/>
                            </ScrollViewer>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Неактивный -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.56"/>
                            </Trigger>

                            <!-- Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7EB4EA"/>
                            </Trigger>

                            <!-- Фокус -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#569DE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== LISTBOX ITEM ====================== -->
        <Style TargetType="{x:Type ListBoxItem}" x:Key="ListBoxItemStyle">
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter 
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Активный элемент -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5F0FF"/>
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>

                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True" SourceName="Border">
                                <Setter TargetName="Border" Property="Background" Value="#F0F5FF"/>
                            </Trigger>

                            <!-- Неактивный -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <!-- Кастомная рамка окна -->
    <Border Grid.Row="0" 
                BorderBrush="#FFAAAAAA" 
                BorderThickness="1" 
                CornerRadius="2"
                Background="White">

        <Border.Effect>
            <DropShadowEffect 
                    Color="#40000000" 
                    BlurRadius="10" 
                    Direction="270" 
                    ShadowDepth="3"/>
        </Border.Effect>

        <Grid Background="White">
            <!-- Кастомный заголовок -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ваш заголовок с крупным шрифтом -->
            <Grid Grid.Row="0" Background="#FFEEEEEE" 
                  MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                               FontSize="14" 
                               Padding="10,5"
                               VerticalAlignment="Center"/>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" 
                            Click="CloseClick" 
                            Style="{StaticResource WindowControlButton}"
                            Tag="CloseButton"
                            ToolTip="Закрыть" IsTabStop="False"/>
                </StackPanel>
            </Grid>

            <!-- Основное содержимое окна -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="infoText" TextWrapping="Wrap" Text="Введите номер заказа (6 цифр, без ЗК-)&#xA;Если заказ не нужен, введите пробел" 
                           Margin="8,5,5,0"/>
                <TextBox x:Name="tbInputText" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" 
                         Style="{StaticResource TextBoxStyle}"
                         Margin="8,8,8,0" KeyDown="tbInputText_KeyDown" TextChanged="tbInputText_TextChanged"/>

                <Button x:Name="okButton" Content="Подтвердить" IsDefault="True" Grid.Row="2" 
                        Style="{StaticResource SmallButtonStyle}"
                        Click="okButton_Click"
                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Margin="0,0,0,8" Width="95" Height="25"/>
            </Grid>


        </Grid>
    </Border>

</Window>
